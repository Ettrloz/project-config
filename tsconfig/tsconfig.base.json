{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "**/.next",
    "**/build",
    "**/dist",
    "**/node_modules",
    "**/types"
  ]
}
